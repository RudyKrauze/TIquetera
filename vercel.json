{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "private/**,public/**,db_schema.sql",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/api/index.js"
    }
  ]
}
