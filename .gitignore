# ==========================================
# GITIGNORE - TICKET SYSTEM / IMAGEN DIAGNÓSTICA
# ==========================================

# 1. Variables de entorno y secretos
.env
.env.local
.env.*.local
!.env.example

# 2. Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 3. Base de datos, backups y dumps
*.sqlite
*.db
*.dump
*.sql.gz
*.tar.gz
backups/*
!backups/.gitkeep

# 4. Archivos multimedia y uploads de usuarios
public/uploads/tickets/*
!public/uploads/tickets/.gitkeep

# 5. Logs y archivos de tiempo de ejecución
logs/
*.log
pids
*.pid
*.seed
*.pid.lock

# 6. Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 8. Archivos temporales y caché
*.tmp
*.temp
.cache/
.scratch/
scratch/
coverage/
.nyc_output/
