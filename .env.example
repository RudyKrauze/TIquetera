# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA DE TIQUETERÍA
# ==============================================================================

# Servidor y Entorno
PORT=3005
NODE_ENV=production

# Seguridad - Clave secreta para firmar tokens JWT (generar con openssl rand -base64 64)
JWT_SECRET=tu_clave_secreta_muy_segura_y_larga_aqui_cambiar_en_produccion

# CORS - Dominios permitidos (separados por comas, ej: tu dominio de Vercel)
ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:3005

# URL Base pública del sistema (usada en enlaces de correos y tableros compartidos)
BASE_URL=https://tu-proyecto.vercel.app

# ==============================================================================
# BASE DE DATOS SUPABASE (RECOMENDADO PARA VERCEL / PRODUCCIÓN)
# ==============================================================================
# Obtén esta URI en Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# En Vercel Serverless se recomienda el Transaction Pooler (puerto 6543) con ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Habilitar SSL para conexión remota a Supabase
DB_SSL=true

# Límite de conexiones del pool (5 para Serverless Vercel, 20 para servidor tradicional)
DB_POOL_MAX=5

# ==============================================================================
# SUPABASE STORAGE (SUBIDA DE IMÁGENES Y ADJUNTOS)
# ==============================================================================
# Obtén las credenciales en Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ==============================================================================
# BASE DE DATOS LOCAL / DOCKER (FALLBACK PARA DESARROLLO LOCAL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiquetera_db
DB_USER=postgres
DB_PASSWORD=tu_password_postgres_aqui

# ==============================================================================
# NOTIFICACIONES PUSH (WEB PUSH / VAPID KEYS)
# ==============================================================================
VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
VAPID_PRIVATE_KEY=tu_vapid_private_key_aqui
VAPID_SUBJECT=mailto:admin@tiquetera.com

# ==============================================================================
# SERVICIO DE CORREO SMTP (Brevo, Gmail, Hostinger, etc.)
# ==============================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp@ejemplo.com
SMTP_PASS=tu_password_smtp
EMAIL_FROM="Soporte Tiquetera <no-reply@tiquetera.com>"
